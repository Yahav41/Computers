<Page
    x:Class="final_project.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:final_project.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/BackGrounds/MenuBackground.png" Stretch="UniformToFill"/>
        </Grid.Background>
        <Viewbox Grid.ColumnSpan="3" Grid.RowSpan="3">
            <Button x:Name="BackButton" Click="BackButton_Click" Background="Transparent" BorderBrush="Transparent" Foreground="Transparent">
                <Image Source="/Assets/Buttons/BackButton.png"></Image>
            </Button>
        </Viewbox>
        <Viewbox Grid.Column="1" Grid.Row="9" Grid.ColumnSpan="9" Grid.RowSpan="2">
            <TextBlock Foreground="Black" TextWrapping="Wrap">Volume:</TextBlock>
        </Viewbox>
        <Viewbox Grid.Column="1" Grid.Row="11" Grid.ColumnSpan="9" Grid.RowSpan="2">
            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100" ValueChanged="VolumeSlider_ValueChanged" Width="220"></Slider>
        </Viewbox>
        <!-- LEFT PLAYER KEYS -->
        <Grid Grid.Row="10" Grid.Column="17" Grid.ColumnSpan="3" Grid.RowSpan="14">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- Move Left -->
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Foreground="White" Margin="0,0,10,0">
            Left Player - Move Left
                </TextBlock>
                <Button x:Name="BtnLeftMoveLeft"
                Click="ChangeKeyClick"
                Tag="LeftPlayerLeft"
                HorizontalAlignment="Stretch"
                Content="(press key)"/>
            </StackPanel>

            <!-- Move Right -->
            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <TextBlock Foreground="White" Margin="0,0,10,0">
            Left Player - Move Right
                </TextBlock>
                <Button x:Name="BtnLeftMoveRight"
                Click="ChangeKeyClick"
                Tag="LeftPlayerRight"
                HorizontalAlignment="Stretch"
                Content="(press key)"/>
            </StackPanel>

            <!-- Move Up -->
            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                <TextBlock Foreground="White" Margin="0,0,10,0">
            Left Player - Move Up
                </TextBlock>
                <Button x:Name="BtnLeftMoveUp"
                Click="ChangeKeyClick"
                Tag="LeftPlayerUp"
                HorizontalAlignment="Stretch"
                Content="(press key)"/>
            </StackPanel>

            <!-- Move Down -->
            <StackPanel Grid.Row="3" Margin="0,0,0,8">
                <TextBlock Foreground="White" Margin="0,0,10,0">
            Left Player - Move Down
                </TextBlock>
                <Button x:Name="BtnLeftMoveDown"
                Click="ChangeKeyClick"
                Tag="LeftPlayerDown"
                HorizontalAlignment="Stretch"
                Content="(press key)"/>
            </StackPanel>

            <!-- Shoot -->
            <StackPanel Grid.Row="4" Margin="0,0,0,8">
                <TextBlock Foreground="White" Margin="0,0,10,0">
            Left Player - Shoot
                </TextBlock>
                <Button x:Name="BtnLeftShoot"
                Click="ChangeKeyClick"
                Tag="LeftPlayerShoot"
                HorizontalAlignment="Stretch"
                Content="(press key)"/>
            </StackPanel>

            <!-- Reload -->
            <StackPanel Grid.Row="5" Margin="0,0,0,8">
                <TextBlock Foreground="White" Margin="0,0,10,0">
            Left Player - Reload
                </TextBlock>
                <Button x:Name="BtnLeftReload"
                Click="ChangeKeyClick"
                Tag="LeftPlayerReload"
                HorizontalAlignment="Stretch"
                Content="(press key)"/>
            </StackPanel>
        </Grid>
        <!-- RIGHT PLAYER KEYS -->
        <Grid Grid.Row="10" Grid.Column="21" Grid.ColumnSpan="3" Grid.RowSpan="14">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- Move Left -->
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Foreground="White" Margin="0,0,10,0">
            Right Player - Move Left
                </TextBlock>
                <Button x:Name="BtnRightMoveLeft"
                Click="ChangeKeyClick"
                Tag="RightPlayerLeft"
                HorizontalAlignment="Stretch"
                Content="(press key)"/>
            </StackPanel>

            <!-- Move Right -->
            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <TextBlock Foreground="White" Margin="0,0,10,0">
            Right Player - Move Right
                </TextBlock>
                <Button x:Name="BtnRightMoveRight"
                Click="ChangeKeyClick"
                Tag="RightPlayerRight"
                HorizontalAlignment="Stretch"
                Content="(press key)"/>
            </StackPanel>

            <!-- Move Up -->
            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                <TextBlock Foreground="White" Margin="0,0,10,0">
            Right Player - Move Up
                </TextBlock>
                <Button x:Name="BtnRightMoveUp"
                Click="ChangeKeyClick"
                Tag="RightPlayerUp"
                HorizontalAlignment="Stretch"
                Content="(press key)"/>
            </StackPanel>

            <!-- Move Down -->
            <StackPanel Grid.Row="3" Margin="0,0,0,8">
                <TextBlock Foreground="White" Margin="0,0,10,0">
            Right Player - Move Down
                </TextBlock>
                <Button x:Name="BtnRightMoveDown"
                Click="ChangeKeyClick"
                Tag="RightPlayerDown"
                HorizontalAlignment="Stretch"
                Content="(press key)"/>
            </StackPanel>

            <!-- Shoot -->
            <StackPanel Grid.Row="4" Margin="0,0,0,8">
                <TextBlock Foreground="White" Margin="0,0,10,0">
            Right Player - Shoot
                </TextBlock>
                <Button x:Name="BtnRightShoot"
                Click="ChangeKeyClick"
                Tag="RightPlayerShoot"
                HorizontalAlignment="Stretch"
                Content="(press key)"/>
            </StackPanel>

            <!-- Reload -->
            <StackPanel Grid.Row="5" Margin="0,0,0,8">
                <TextBlock Foreground="White" Margin="0,0,10,0">
            Right Player - Reload
                </TextBlock>
                <Button x:Name="BtnRightReload"
                Click="ChangeKeyClick"
                Tag="RightPlayerReload"
                HorizontalAlignment="Stretch"
                Content="(press key)"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
